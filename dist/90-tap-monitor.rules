# Starts tap-monitor@ocp<N>.service for each timecard, stopped by systemd when the card goes away.
# The alias gives the card a device unit named after it, sys-subsystem-timecard-devices-ocp<N>.device
SUBSYSTEM=="timecard", KERNEL=="ocp*", TAG+="systemd", ENV{SYSTEMD_ALIAS}+="/sys/subsystem/timecard/devices/%k", ENV{SYSTEMD_WANTS}+="tap-monitor@%k.service"
